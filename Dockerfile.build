# Produces native Linux binaries for export; the agent runs under host systemd.
# Pin the builder image digest in your release pipeline after staging validation.
ARG GO_IMAGE=golang:1.27.1-bookworm
FROM ${GO_IMAGE} AS build
ARG DOCKYARD_VERSION=dev
ARG DOCKYARD_COMMIT=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN go test -race ./... && go vet ./...
RUN CGO_ENABLED=1 go build -trimpath -ldflags="-s -w -X github.com/ziqx/ziqx-dockyard-service/internal/buildinfo.Version=${DOCKYARD_VERSION} -X github.com/ziqx/ziqx-dockyard-service/internal/buildinfo.Commit=${DOCKYARD_COMMIT}" -o /out/dockyard ./cmd/dockyard && \
    CGO_ENABLED=1 go build -trimpath -ldflags="-s -w -X github.com/ziqx/ziqx-dockyard-service/internal/buildinfo.Version=${DOCKYARD_VERSION} -X github.com/ziqx/ziqx-dockyard-service/internal/buildinfo.Commit=${DOCKYARD_COMMIT}" -o /out/dockyardctl ./cmd/dockyardctl
RUN /out/dockyard -version-json | grep -F "\"version\":\"${DOCKYARD_VERSION}\"" && \
    /out/dockyardctl -version-json | grep -F "\"version\":\"${DOCKYARD_VERSION}\""
FROM scratch AS binaries
COPY --from=build /out/ /
