[Unit]
Description=Ziqx Dockyard privileged deployment API
After=network-online.target docker.service caddy.service
Wants=network-online.target docker.service caddy.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/dockyard -config /etc/dockyard/config.json
Restart=always
RestartSec=5s
TimeoutStopSec=45s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
# Required to traverse Caddy's private service directory and connect to its
# caddy-owned mode-0600 admin socket. Filesystem mount restrictions still apply.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
ProtectSystem=strict
# Read-only, so Dockyard can use root's `docker login` (/root/.docker) for
# private registries. Nothing under /home or /root is writable.
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Importing reviewed existing routes atomically replaces the main Caddyfile,
# so its parent directory must be writable as well as the generated snippets.
ReadWritePaths=/docker /var/lib/dockyard /etc/caddy
LimitNOFILE=4096
TasksMax=128
MemoryMax=512M

[Install]
WantedBy=multi-user.target
