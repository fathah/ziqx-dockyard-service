{
  "name": "dockyard-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "server:bundle": "bash scripts/package-server.sh",
    "desktop:build": "tauri build --bundles app --config src-tauri/tauri.local.conf.json -- --locked",
    "test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:naming": "node --experimental-strip-types --test tests/project-naming.test.mjs",
    "format": "prettier --write src package.json tsconfig.json vite.config.ts index.html",
    "desktop:release": "tauri build --bundles app -- --locked",
    "test:editor": "node --experimental-strip-types --test tests/compose-editor.test.mjs",
    "test:route": "node --experimental-strip-types --test tests/compose-route.test.mjs",
    "editor:schema": "node scripts/generate-compose-validator.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "2.12.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@ziqx/react-comps": "0.5.0",
    "ajv": "8.20.0",
    "codemirror": "6.0.2",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hot-toast": "2.6.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  }
}
