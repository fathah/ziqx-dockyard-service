{
  "identifier": "main",
  "description": "Local bundled control room only. No webview HTTP, shell, filesystem, or external URL permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-session-info",
    "allow-enroll",
    "allow-unlock",
    "allow-lock-session",
    "allow-forget-device",
    "allow-read-api",
    "allow-mutate",
    "allow-retry-pending",
    "allow-pending-info",
    "allow-import-compose",
    "allow-setup-inspect",
    "allow-setup-install",
    "allow-setup-resume",
    "allow-setup-cancel",
    "allow-terminal-connect",
    "allow-terminal-start",
    "allow-terminal-input",
    "allow-terminal-resize",
    "allow-terminal-poll",
    "allow-terminal-close",
    "allow-terminal-forget-password",
    "allow-server-update-check",
    "allow-server-update-apply",
    "allow-server-access-check",
    "allow-server-access-prepare",
    "allow-server-compose-enable",
    "allow-provider-list",
    "allow-provider-connect",
    "allow-provider-remove",
    "allow-provider-token-page",
    "allow-provider-zones",
    "allow-provider-records",
    "allow-provider-write",
    "allow-preview-blue-green"
  ]
}
